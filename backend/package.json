{
  "name": "turesma-backend",
  "version": "1.0.0",
  "description": "Backend API para Turesma",
  "engines": {
    "node": ">=22",
    "npm": ">=7"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "start": "node dist/server.js",
    "seed": "tsx -r dotenv/config src/config/seed.ts"
  },
  "keywords": [
    "turesma",
    "api",
    "express"
  ],
  "author": "Turesma",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "@xmldom/xmldom": "^0.9.12",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "node-forge": "^1.4.2",
    "nodemailer": "^10.2.1",
    "osodreamer-sri-xml-signer": "^0.3.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "sharp": "^0.35.4",
    "typescript": "^5.8.2",
    "xml-crypto": "^6.4.0",
    "xmlbuilder2": "^4.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}

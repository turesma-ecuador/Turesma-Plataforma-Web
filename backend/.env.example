PORT=4000
# Origen público HTTPS de la API; en AtukHosting usa https://api.turesma.com.
API_PUBLIC_URL=http://localhost:4000
# En producción configura una ruta persistente fuera del checkout del repositorio.
UPLOADS_DIR=uploads
# Usa un secreto aleatorio seguro y exclusivo del backend.
JWT_SECRET=replace_with_a_strong_random_backend_secret
JWT_EXPIRES_IN=7d
DB_USER=postgres
DB_HOST=localhost
DB_NAME=turesma_db
DB_PASSWORD=replace_with_local_database_password
DB_PORT=5432
DB_SSL=false
DATABASE_URL=

# Recuperacion de contraseña por correo (SMTP)
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=replace_with_smtp_app_password
SMTP_FROM=Turesma <your_email@example.com>
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
PASSWORD_RESET_PIN_TTL_MINUTES=10

# PayPhone Button/Prepare. El token y el StoreID se obtienen en PayPhone Developers.
PAYPHONE_API_URL=https://pay.payphonetodoesposible.com/api
PAYPHONE_TOKEN=replace_with_payphone_token
PAYPHONE_STORE_ID=replace_with_payphone_store_id
WEB_URL=http://localhost:3000

# Facturación electrónica SRI
SRI_CERTIFICATE_PATH=certificado/Turesma.p12
SRI_CERTIFICATE_PASSWORD=replace_with_sri_certificate_password
SRI_ENVIRONMENT=pruebas
SRI_RUC=1391763581001
SRI_RAZON_SOCIAL=TURISMO ESMERALDA S.A. TURESMA
SRI_NOMBRE_COMERCIAL=TURESMA S.A.
SRI_DIRECCION_MATRIZ=PRINCIPAL 14
SRI_ESTABLECIMIENTO=001
SRI_PUNTO_EMISION=002
SRI_SECUENCIAL=298

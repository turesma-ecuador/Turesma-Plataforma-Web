# Configuración de la API Node.js en cPanel (Node.js 22).
NODE_ENV=production
API_PUBLIC_URL=https://api.turesma.com
# Directorio persistente fuera de repositories/Turesma-Plataforma-Web.
UPLOADS_DIR=/home3/ojtaagta/turesma-storage

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ojtaagta_turesma_db
DB_USER=ojtaagta_turesma_app
DB_PASSWORD=replace_with_the_current_database_password
DB_SSL=false
DATABASE_URL=

# Genera una clave fuerte y única. No reutilices JWT_SECRET de desarrollo.
JWT_SECRET=replace_with_a_long_random_production_secret
JWT_EXPIRES_IN=7d

WEB_URL=https://turesma.com
CORS_ORIGIN=https://turesma.com,https://www.turesma.com

# Completa solo con las credenciales de servicios que ya utilice la aplicación.
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
PASSWORD_RESET_PIN_TTL_MINUTES=10

PAYPHONE_API_URL=https://pay.payphonetodoesposible.com/api
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

SRI_CERTIFICATE_PATH=certificado/Turesma.p12
SRI_CERTIFICATE_PASSWORD=
SRI_ENVIRONMENT=pruebas
SRI_RUC=1391763581001
SRI_RAZON_SOCIAL=TURISMO ESMERALDA S.A. TURESMA
SRI_NOMBRE_COMERCIAL=TURESMA S.A.
SRI_DIRECCION_MATRIZ=PRINCIPAL 14
SRI_ESTABLECIMIENTO=001
SRI_PUNTO_EMISION=002
SRI_SECUENCIAL=298
